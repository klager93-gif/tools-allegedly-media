{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal Schedule Assignments Read Response",
  "version": "v1.9.0",
  "type": "object",
  "required": [
    "ok",
    "data",
    "meta",
    "errors"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "required": [
        "templates",
        "assignments"
      ],
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "meta": {
      "type": "object"
    },
    "errors": {
      "type": "array"
    }
  }
}
