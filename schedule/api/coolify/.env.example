# Signal Schedule Coolify API environment example
# Do not commit real secrets.

PORT=3000
NODE_ENV=production

# Preferred future backend for Schedule v1.7+
# Example only. Replace with the Coolify/Postgres internal connection string.
DATABASE_URL=postgres://signal_schedule_user:change-me@postgres:5432/signal_schedule

# v1.7 remains read-only. Set to true only after Postgres seed/migration work is complete.
USE_POSTGRES_EMPLOYEES=false
